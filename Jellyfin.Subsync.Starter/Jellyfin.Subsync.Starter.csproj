<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Jellyfin.Subsync.Starter</RootNamespace>
    <Authors>Marnalas</Authors>
    <Company>Marnalas</Company>
    <Product>Subsync-Starter</Product>
    <Description>Automatically re-syncs out-of-sync subtitles using ffsubsync.</Description>
    <PackageId>Jellyfin.Subsync.Starter</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Subsync.Starter.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Model" Version="10.11.0" />
    <PackageReference Include="Jellyfin.Controller" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.18" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <None Remove="Configuration\configPage.js" />
    <EmbeddedResource Include="Configuration\configPage.js" />
    <None Remove="Configuration\configCachePage.html" />
    <EmbeddedResource Include="Configuration\configCachePage.html" />
    <None Remove="Configuration\configCachePage.js" />
    <EmbeddedResource Include="Configuration\configCachePage.js" />
    <None Remove="Configuration\configSyncPage.html" />
    <EmbeddedResource Include="Configuration\configSyncPage.html" />
    <None Remove="Configuration\configSyncPage.js" />
    <EmbeddedResource Include="Configuration\configSyncPage.js" />
  </ItemGroup>

</Project>
