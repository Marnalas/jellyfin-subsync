# The build context is this directory (see the `sidecar` job in
# .github/workflows/build-release.yml), so this is where the excludes belong -
# a .dockerignore at the repo root would never be read.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Documentation and the compose fragment are for humans reading the repo; the
# image only needs requirements.txt and app.py.
compose.yml
*.md

# The test suite and its dependencies ship nowhere. The Dockerfile only COPYs
# requirements.txt and app.py, so nothing would leak either way - excluding
# them keeps the build context small and stops an edit to a test from
# invalidating the image cache.
tests/
requirements-dev.txt
pytest.ini
